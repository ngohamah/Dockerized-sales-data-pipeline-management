# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# --- Postgres (shared instance: `airflow` + `app_data` databases) ---
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=change_me_postgres

# --- MinIO ---
MINIO_ROOT_USER=platform_admin
MINIO_ROOT_PASSWORD=change_me_minio

# --- Airflow ---
# Linux hosts: set to your `id -u` to avoid volume permission issues.
AIRFLOW_UID=50000
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=change_me_webserver_secret
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change_me_admin
